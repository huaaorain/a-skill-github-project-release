{
  "schema_version": 1,
  "project": {
    "name": "A Skill: Github Project Release",
    "description": "A Codex skill for publishing GitHub projects with release-only assets, multilingual READMEs, and collapsible localized release notes.",
    "repository": "huaaorain/a-skill-github-project-release",
    "homepage": "",
    "topics": [
      "codex-skill",
      "github",
      "release-automation",
      "github-releases",
      "readme",
      "project-publishing",
      "localization",
      "release-notes"
    ]
  },
  "release": {
    "tag_prefix": "v",
    "initial_version": "0.1.0",
    "draft": true,
    "prerelease": false
  },
  "artifact_policy": "release-only",
  "readme": {
    "path": "README.md",
    "locales": [
      {
        "path": "README.md",
        "label": "简体中文",
        "catalog_labels": {
          "latest": "最新版本",
          "version": "版本",
          "published": "发布时间",
          "release_notes": "发布说明",
          "downloads": "全部版本下载",
          "open": "打开",
          "source_zip": "源代码（zip）",
          "source_tar": "源代码（tar.gz）",
          "no_assets": "没有已上传的附件。",
          "no_releases": "暂无已发布版本。"
        }
      },
      {
        "path": "README.zh-TW.md",
        "label": "繁體中文",
        "catalog_labels": {
          "latest": "最新版本",
          "version": "版本",
          "published": "發佈時間",
          "release_notes": "發佈說明",
          "downloads": "全部版本下載",
          "open": "開啟",
          "source_zip": "原始碼（zip）",
          "source_tar": "原始碼（tar.gz）",
          "no_assets": "尚未上傳附件。",
          "no_releases": "尚無已發佈版本。"
        }
      },
      {
        "path": "README.en.md",
        "label": "English",
        "catalog_labels": {
          "latest": "Latest",
          "version": "Version",
          "published": "Published",
          "release_notes": "Release notes",
          "downloads": "All version downloads",
          "open": "Open",
          "source_zip": "Source code (zip)",
          "source_tar": "Source code (tar.gz)",
          "no_assets": "No uploaded assets.",
          "no_releases": "No published releases yet."
        }
      }
    ],
    "catalog_start": "<!-- release-catalog:start -->",
    "catalog_end": "<!-- release-catalog:end -->"
  },
  "release_notes": {
    "layout": "accordion",
    "open_locale": "zh-CN",
    "prompt": "点击语言名称展开对应版本说明。 / Select a language to expand its release notes.",
    "locales": [
      {
        "id": "zh-CN",
        "label": "简体中文",
        "path_template": "docs/releases/{tag}.zh-CN.md"
      },
      {
        "id": "zh-TW",
        "label": "繁體中文",
        "path_template": "docs/releases/{tag}.zh-TW.md"
      },
      {
        "id": "en",
        "label": "English",
        "path_template": "docs/releases/{tag}.en.md"
      }
    ],
    "file_table": {
      "title": "发布文件 / Release files",
      "description_locales": ["zh-CN", "en"],
      "columns": {
        "file": "文件 / File",
        "role": "类型 / Role",
        "purpose": "用途 / Purpose",
        "size": "大小 / Size",
        "download": "下载 / Download",
        "download_link": "Download"
      }
    },
    "metadata": {
      "title": "校验与元数据 / Checksums and metadata"
    },
    "source": {
      "title": "源代码 / Source",
      "commit_label": "提交 / Commit",
      "source_zip_label": "源代码 ZIP / Source ZIP",
      "source_tar_label": "源代码 TAR.GZ / Source TAR.GZ",
      "verify": "下载后请使用 `SHA256SUMS.txt` 校验文件完整性。  \nVerify downloaded files against `SHA256SUMS.txt`."
    }
  },
  "screenshots": [
    {
      "path": "docs/assets/release-flow.svg",
      "description": "A Skill: Github Project Release 的构建、预检、Draft Release 与版本目录同步流程。"
    }
  ],
  "artifacts": [
    {
      "path": "release-build/a-skill-github-project-release.zip",
      "role": "skill",
      "description": "完整 skill 包，包括 SKILL.md、scripts、references、assets 与 README。",
      "localized_descriptions": {
        "zh-CN": "完整 skill 包，包括说明、脚本、参考文档、模板与测试。",
        "en": "Complete skill package with documentation, scripts, references, templates, and tests."
      },
      "required": true,
      "download_name": "a-skill-github-project-release.zip"
    }
  ]
}
