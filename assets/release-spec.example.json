        "label": "繁體中文",
        "path_template": "docs/releases/{tag}.zh-TW.md"
      },
      {
        "id": "en",
        "label": "English",
        "path_template": "docs/releases/{tag}.en.md"
      }
    ],
    "file_table": {
      "title": "发布文件 / Release files",
      "description_locales": ["zh-CN", "en"],
      "columns": {
        "file": "文件 / File",
        "role": "类型 / Role",
        "purpose": "用途 / Purpose",
        "size": "大小 / Size",
        "download": "下载 / Download",
        "download_link": "Download"
      }
    },
    "metadata": {
      "title": "校验与元数据 / Checksums and metadata"
    },
    "source": {
      "title": "源代码 / Source",
      "commit_label": "提交 / Commit",
      "source_zip_label": "源代码 ZIP / Source ZIP",
      "source_tar_label": "源代码 TAR.GZ / Source TAR.GZ",
      "verify": "下载后请使用 `SHA256SUMS.txt` 校验文件完整性。  \nVerify downloaded files against `SHA256SUMS.txt`."
